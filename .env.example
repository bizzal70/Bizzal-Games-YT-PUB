# Copy this file to a local env file (e.g. ~/.config/bizzal.env, or .env.ai for
# AI-only flags) and fill in real values. Never commit the filled-in file.
#
# This covers the credentials and feature toggles you need to actually run the
# pipeline. Render-tuning knobs (BIZZAL_BG_*, BIZZAL_BODY_*, timing/audio
# controls, etc.) all have working defaults — see docs/DEPLOYMENT.md for the
# full list if you want to tune them.

# ---- Discord (approval gate + health notifications) ----
BIZZAL_REQUIRE_DISCORD_APPROVAL=1
BIZZAL_DISCORD_WEBHOOK_URL=
BIZZAL_DISCORD_BOT_TOKEN=
BIZZAL_DISCORD_CHANNEL_ID=
BIZZAL_DISCORD_APPROVER_USER_IDS=

# ---- YouTube (OAuth upload) ----
# Either point at a downloaded OAuth client JSON...
BIZZAL_YT_CLIENT_SECRETS=~/.config/bizzal/youtube_client_secrets.json
BIZZAL_YT_TOKEN_FILE=~/.config/bizzal/youtube_token.json
# ...or set client id/secret directly if Google Cloud won't let you download JSON:
BIZZAL_YT_CLIENT_ID=
BIZZAL_YT_CLIENT_SECRET=
BIZZAL_YT_PRIVACY=private
BIZZAL_YT_CATEGORY_ID=20

# ---- AI features (all optional; pipeline falls back to deterministic
# templates / no-AI behavior if these are unset) ----
BIZZAL_ENABLE_AI=0
BIZZAL_ENABLE_AI_SCRIPT=0
OPENAI_API_KEY=
BIZZAL_OPENAI_MODEL=gpt-4o-mini

BIZZAL_ENABLE_TTS=0
BIZZAL_TTS_MODEL=gpt-4o-mini-tts

BIZZAL_ENABLE_BG_IMAGE=0
BIZZAL_ENABLE_BG_MUSIC=0
REPLICATE_API_TOKEN=

# ---- Reference corpus source (optional — only needed if you sync the SRD
# corpus in from a remote host instead of using the copy already in the repo) ----
BIZZAL_REFERENCE_SOURCE_HOST=
BIZZAL_REFERENCE_SOURCE_USER=
BIZZAL_REFERENCE_SOURCE_PATH=

# ---- Email health notifications (optional alternative to Discord) ----
BIZZAL_SMTP_HOST=smtp.gmail.com
BIZZAL_SMTP_PORT=587
BIZZAL_SMTP_USER=
BIZZAL_SMTP_PASS=
BIZZAL_SMTP_STARTTLS=1
BIZZAL_SMTP_SSL=0
BIZZAL_ALERT_EMAIL_TO=
BIZZAL_ALERT_EMAIL_FROM=
