# Shell/Python scripts must stay LF so they run on the Linux Actions runner
# (CRLF would break the shebang). Force it regardless of a Windows checkout.
*.sh text eol=lf
*.py text eol=lf

# Track large reference assets with Git LFS
reference/open5e/**/*.json filter=lfs diff=lfs merge=lfs -text
reference/srd/**/*.pdf filter=lfs diff=lfs merge=lfs -text
