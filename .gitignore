# runtime + logs
runtime/
logs/
tmp/

# generated and archival outputs
data/archive/
data/atoms/
data/atoms_shadowdark/
data/manifests/
data/renders/
data/renders_shadowdark/
data/www/

# Cloud pipeline safety-state: small JSON (publish dedup registry, variety
# history, autopublish record) that GitHub Actions commits back to the repo so
# it survives ephemeral runners. Tracked on purpose; renders/atoms stay out.
!data/state/
!data/state/*.json

# large/replaceable assets (optional; you can choose to keep these in git later)
data/assets/

# reference corpuses
# keep canonical committed corpuses in git under:
# - reference/open5e/
# - reference/srd/
# keep generated pointers/snapshots out of git:
reference/active
reference/snapshots/
reference/systems/shadowdark/source_pdfs/*.pdf
reference/systems/dnd5e/source_pdfs/*.pdf

# misc
__pycache__/
*.pyc
*.bak
*.BAK*
.venv/
.vscode/
docs/ops_backups/

# local secrets
.env.ai
.env.discord_health
.env.health_mail

# windows ADS metadata copied as files under WSL
*:Zone.Identifier
